# 工具與驅動二進位由既有下載/雜湊流程管理，不提交 Git。
/drivers/*/*
!/drivers/*/profile.json
!/drivers/*/manifest.json
!/drivers/*/readme.md
/Driver/
*.zip
*.bin
*.7z
*.rar
*.exe
*.dll
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.cab
*.iso
*.pdb
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.ttf
*.woff
*.woff2

# 各電腦執行產物、備份與快取不得進入可重用的工具版本。
/package_hashes.json
*-Result.json
*-Verification.json
*-Progress.json
*-Previous-*.json
*-Actual-*.json
*-Before-*.reg
*-Before-*.txt
*-After.txt
*-Console*.txt
*-Parse.txt
*.log
*.tmp
*.bak
*.old
[Ll]ogs/
[Cc]ache/
DriverLogs/
driver_logs/
DriverCache/
LegacyLogs/
RegistryBackups/
[Oo]utputs/
[Rr]eports/
[Tt]emp/
[Tt]mp/
Verification-Result.json
Acceptance-Result.json

# 私密連線資料不提交。站點範本與空設定框架可追蹤。
.ssh/
known_hosts*
id_rsa*
id_ed25519*
id_ecdsa*
*.key
*.pem
*.pfx
*.p12
.env
.env.*
*credentials*
*passwords*

# Git 自身的資料庫不進入工作樹版本。
.git/

# CustomHostsSync 每機狀態、擁有者與備份，禁止因複製執行目錄而誤提交。
# sites.json、程式來源與測試檔仍可追蹤。
/CustomHostsSync/runtime.json
/CustomHostsSync/owner.json
/CustomHostsSync/status.json
/CustomHostsSync/last-error.json
/CustomHostsSync/last-error.txt
/CustomHostsSync/watcher-last-error.json
/CustomHostsSync/watcher-last-error.txt
/CustomHostsSync/watcher-fatal-error.json
/CustomHostsSync/watcher-fatal-error.txt
/CustomHostsSync/hosts*.backup
/CustomHostsSync/ssh-config-before-*.backup

# Modular package binary payload and per-machine hosts runtime.
/modules/drivers/payload/

/modules/ssh/custom_hosts_sync/runtime.json
/modules/ssh/custom_hosts_sync/owner.json
/modules/ssh/custom_hosts_sync/status.json
/modules/ssh/custom_hosts_sync/*error*
/modules/ssh/custom_hosts_sync/*.backup

# Init 本機機密暫存：只追蹤可重用腳本、測試及說明。
/modules/init/answer.xml
/modules/init/state.json
/modules/init/cleanup-result.json
/modules/init/assets/*.cat
NUC-Init/

# Win11Debloat 上游原始資產；不是安裝程式或每機資料。
!/modules/debloat/win11debloat/Assets/Images/menu.png
!/modules/debloat/win11debloat/Assets/Start/start2.bin

# CI output is short-lived; never commit generated reports.
/test_results/

# Legacy manifest remains ignored during upgrades.
/Package-Hashes.json

# Python verification tools never commit bytecode.
__pycache__/
*.py[cod]

# 本機開發工作樹不進入交付來源。
/worktree/
